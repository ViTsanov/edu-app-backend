# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/english_learning_db

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

FIREBASE_CRED_PATH=english-app-4ab7d-firebase-adminsdk-fbsvc-eaea0414ee.json
